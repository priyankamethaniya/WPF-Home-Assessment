<Window x:Class="CustomerManagement.Views.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomerManagement.Views"
        xmlns:control="clr-namespace:StyledComponent;assembly=StyledComponent"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="{Binding Title}" Height="480" Width="460">
    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="{Binding Title}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- First Name -->

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="First Name:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,2"/>

        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Text="{Binding FirstName,
                                UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,2"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Text="{Binding FirstNameError}"
                   Foreground="Red"
                   FontSize="11"
                   Margin="0,0,0,8"/>

        <!-- Last Name -->

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Last Name:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,2"/>

        <TextBox Grid.Row="3"
                 Grid.Column="1"
                 Text="{Binding LastName,
                                UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,2"/>

        <TextBlock Grid.Row="4"
                   Grid.Column="1"
                   Text="{Binding LastNameError}"
                   Foreground="Red"
                   FontSize="11"
                   Margin="0,0,0,8"/>

        <!-- Email -->

        <TextBlock Grid.Row="5"
                   Grid.Column="0"
                   Text="Email:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,2"/>

        <TextBox Grid.Row="5"
                 Grid.Column="1"
                 Text="{Binding Email,
                                UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,2"/>

        <TextBlock Grid.Row="6"
                   Grid.Column="1"
                   Text="{Binding EmailError}"
                   Foreground="Red"
                   FontSize="11"
                   Margin="0,0,0,8"/>

        <!-- Phone -->

        <TextBlock Grid.Row="7"
                   Grid.Column="0"
                   Text="Phone:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,2"/>

        <TextBox Grid.Row="7"
                 Grid.Column="1"
                 Text="{Binding Phone,
                                UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,2"/>

        <TextBlock Grid.Row="8"
                   Grid.Column="1"
                   Text="{Binding PhoneError}"
                   Foreground="Red"
                   FontSize="11"
                   Margin="0,0,0,8"/>

        <!-- Status -->

        <TextBlock Grid.Row="9"
                   Grid.Column="0"
                   Text="Status:"
                   VerticalAlignment="Center"
                   Margin="0,0,10,10"/>

        <ComboBox Grid.Row="9"
                  Grid.Column="1"
                  ItemsSource="{Binding StatusOptions}"
                  SelectedItem="{Binding Status}"
                  Margin="0,0,0,10"/>

        <!-- Buttons -->

        <StackPanel Grid.Row="11"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <control:StyledAppButton Content="Save"
                                      Variant="Primary"
                                      Width="90"
                                      Height="32"
                                      Margin="0,0,10,0"
                                      IsEnabled="{Binding IsValid}"
                                      Click="SaveButton_Click"/>

            <control:StyledAppButton Content="Cancel"
                                      Variant="Secondary"
                                      Width="90"
                                      Height="32"
                                      Click="CancelButton_Click"/>

        </StackPanel>

    </Grid>
</Window>
